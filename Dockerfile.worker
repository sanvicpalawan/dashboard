# Agent worker image.
#
# Runs scripts/agent-worker.mjs, NOT the Next.js server. Claims agent_jobs from
# Postgres, runs the job on its engine (Harness for marketing, OpenCode for code,
# plain Node for scripts), and writes progress back to the database.
#
# Two engines are installed because both are selectable per job:
#   dsh      (@deepseek-ai/dsh)  -- marketing work, headless profile
#   opencode (@opencode/cli)     -- code work
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# Pinned to the release the workstation runs, so behaviour does not drift.
RUN npm install -g @opencode/cli@2.0.30 @deepseek-ai/dsh@0.2.1-rc.5 --no-audit --no-fund \
 && opencode --version \
 && test -f /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js

WORKDIR /app

# Only the database driver and the env loader are needed; installing them in an
# empty directory keeps the Next.js stack out of this image.
RUN npm install --no-audit --no-fund pg@8.20.0 dotenv@17.3.1

COPY scripts ./scripts
COPY config ./config

# The headless Harness profile routes model calls through NVIDIA's
# OpenAI-compatible gateway. No key is stored: apiKeyEnv reads NVIDIA_API_KEY
# from the environment at run time.
RUN mkdir -p /root/.dsh/profiles/headless \
 && cp /app/config/dsh-headless.patch.yml /root/.dsh/profiles/headless/cordis.patch.yml

# Jobs run here unless the dashboard sets AGENT_WORKSPACE_DIR. Created at build
# time too, so a fresh container never starts with a missing directory.
RUN mkdir -p /app/.agent-workspace

ENV NODE_ENV=production \
    OPENCODE_BIN=opencode \
    DSH_BIN=/usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
    AGENT_WORKSPACE_DIR=/app/.agent-workspace \
    AGENT_HEARTBEAT_FILE=/tmp/worker-heartbeat \
    HARNESS_TRANSPORT=headless \
    NO_COLOR=1

# No HTTP port: health is the heartbeat file the worker rewrites every poll.
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
  CMD test -f /tmp/worker-heartbeat || exit 1

ENTRYPOINT ["sh", "/app/scripts/worker-entrypoint.sh"]
