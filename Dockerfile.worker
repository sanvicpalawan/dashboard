# Agent worker image.
#
# This image runs scripts/agent-worker.mjs, NOT the Next.js server. It claims
# agent_jobs from Postgres, runs the OpenCode CLI inside the job directory, and
# writes progress back to the database.
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client ca-certificates curl zstd \
 && rm -rf /var/lib/apt/lists/*

# Local inference engine. The models are deliberately not baked in: they live on
# the ollama_models volume, so a rebuild reuses them instead of downloading 1.9 GB
# again. Until 2026-10-24 Ollama was installed by hand inside the running
# container, which meant every rebuild silently produced a worker that could not
# run a local model at all.
ARG OLLAMA_VERSION=0.40.10
RUN curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION=${OLLAMA_VERSION} sh \
 && ollama --version

# Same OpenCode release as the workstation, resolved to the Linux binary package.
RUN npm install -g @opencode/cli@2.0.30 \
 && opencode --version

WORKDIR /app

# Only the database driver and the env loader are needed; installing them in an
# empty directory keeps the Next.js stack out of this image.
RUN npm install --no-audit --no-fund pg@8.20.0 dotenv@17.3.1

COPY scripts ./scripts
COPY config ./config

ENV NODE_ENV=production \
    OPENCODE_BIN=opencode \
    AGENT_HEARTBEAT_FILE=/tmp/worker-heartbeat

# The worker has no HTTP port: health is the heartbeat file it touches every poll.
HEALTHCHECK --interval=60s --timeout=10s --start-period=90s --retries=3 \
  CMD test -f /tmp/worker-heartbeat && [ $(( $(date +%s) - $(date -r /tmp/worker-heartbeat +%s) )) -lt 180 ] || exit 1

ENTRYPOINT ["sh", "/app/scripts/worker-entrypoint.sh"]
