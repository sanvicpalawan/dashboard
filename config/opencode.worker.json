{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (home machine)",
      "options": {
        "baseURL": "__OLLAMA_BASE_URL__/v1",
        "apiKey": "__OLLAMA_API_KEY__",
        "headers": {
          "x-merqato-agent": "__OLLAMA_API_KEY__"
        }
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen2.5 Coder 3B (local)"
        }
      }
    }
  },
  "model": "ollama/qwen2.5-coder:3b"
}
