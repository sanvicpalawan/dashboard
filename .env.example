# ---------------------------------------------------------------------------
# Neon Postgres
# ---------------------------------------------------------------------------
# `neon env pull` (or `neon deploy`) writes these three automatically.
# DATABASE_URL          pooled (-pooler) endpoint -- used by the application
# DATABASE_URL_UNPOOLED direct endpoint          -- used by migrations, dumps
# Running migrations over the pooler fails with confusing session-state errors.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Optional: maximum pooled connections this instance may open (default 10).
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# First-run administrator (used only when no user exists)
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_INITIAL_PASSWORD

# Generate with: openssl rand -base64 48
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_ENCRYPTION_KEY
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_AUTH_SECRET

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# false for production; true seeds clearly labeled fictional agency records
DEMO_MODE=false
# Run checked-in Drizzle migrations on startup; use one application replica during migration
AUTO_MIGRATE=true
COOKIE_SECURE=true
APP_PORT=3000
# Optional: enables signed GitHub webhook receiver at /api/webhooks/github?workspace=WORKSPACE_UUID
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# Provider credentials are intentionally not read from public environment variables.
# Configure them in Admin -> Integrations so they are encrypted in PostgreSQL.
